# Public, non-secret local defaults. Copy to .env.local; never commit real credentials.
ASDO_API_ENVIRONMENT=local
ASDO_API_SERVICE_NAME=asdo-api
ASDO_API_TELEMETRY_ENABLED=true
ASDO_API_METRICS_ENABLED=true
ASDO_API_OTLP_ENDPOINT=http://localhost:4318/v1/traces
NEXT_PUBLIC_ASDO_ENVIRONMENT=local
NEXT_PUBLIC_ASDO_API_BASE_URL=http://localhost:8000/api/v1
