{
  "name": "autonomous-software-delivery-organization",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral autonomous software delivery platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "format": "prettier --write . && uv run ruff format .",
    "format:check": "prettier --check . && uv run ruff format --check .",
    "lint": "pnpm lint:js && pnpm lint:python && pnpm lint:workspace",
    "lint:js": "eslint . --max-warnings 0",
    "lint:python": "uv run ruff check .",
    "lint:workspace": "node scripts/check-workspace.mjs",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:python",
    "typecheck:ts": "pnpm -r --if-present typecheck",
    "typecheck:python": "uv run mypy services",
    "test": "pnpm test:unit",
    "test:unit": "pnpm test:unit:ts && pnpm test:unit:python",
    "test:unit:ts": "pnpm -r --if-present test:unit",
    "test:unit:python": "uv run pytest services -m unit --cov=autonomous_sdo_api --cov-branch --cov-fail-under=90",
    "db:up": "node scripts/database.mjs up",
    "db:down": "node scripts/database.mjs down",
    "db:migrate": "node scripts/database.mjs migrate",
    "test:integration": "node scripts/database.mjs test",
    "test:security": "node scripts/check-no-secrets.mjs && node scripts/platform.mjs test-platform && node scripts/container.mjs smoke && pnpm audit --prod --audit-level high",
    "build": "pnpm -r --if-present build && uv build --package asdo-api && node scripts/container.mjs build",
    "container:smoke": "node scripts/container.mjs smoke",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:security",
    "dev-infra": "node scripts/platform.mjs dev-infra",
    "test:e2e": "node scripts/not-available.mjs 1B test-e2e",
    "test:mutation": "node scripts/not-available.mjs 4B test-mutation",
    "deploy:local": "node scripts/platform.mjs deploy-local",
    "smoke:test": "node scripts/platform.mjs smoke-test",
    "backup": "node scripts/not-available.mjs 7C backup",
    "restore": "node scripts/not-available.mjs 7C restore",
    "rollback": "node scripts/not-available.mjs 6C rollback"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
